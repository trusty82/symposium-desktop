{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Symposium",
  "version": "0.8.0",
  "identifier": "fr.symposium.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Symposium",
        "width": 920,
        "height": 660,
        "resizable": true,
        "visible": false,
        "center": true,
        "minWidth": 640,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Relie l'addon Symposium au site de la guilde",
    "publisher": "Guilde Symposium",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "category": "Utility"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4RjQ3ODE0Q0I1RUQ2MTAKUldRUTFsN0xGSGowQ0xyVnJqNEsvQ0RmKzdESWxyalE2VHFIM3AwVDZaQzU3THVkbjdaa1ZvSVAK",
      "endpoints": [
        "https://symposium-gaming.com/application/latest.json",
        "https://github.com/trusty82/symposium-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}